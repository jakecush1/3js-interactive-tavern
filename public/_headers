# Response headers for Cloudflare (read from the built site's root).
#
# Everything under /assets is written by the build with a hash of its
# contents in its name (the scripts, the stylesheet, the fonts), so a given
# URL can never mean different bytes. Browsers may keep those for a year
# and not even ask whether they have changed: a returning visitor loads the
# code from disk without a single request. index.html is not covered, so a
# new deploy is still picked up at once.
#
# The songs and pictures in /audio, /artwork and /band keep their names
# when replaced, so they are left on the default (cached, but checked for
# changes on each visit).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
